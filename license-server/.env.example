PORT=8000
# Docker Compose: DB password (must match the postgres container).
# Do not set DATABASE_URL/REDIS_URL in .env for docker — hosts must be `postgres`/`redis`.
POSTGRES_PASSWORD=postgres

# Generate: openssl rand -base64 24 | tr -d '\n/' | head -c 32
HMAC_SECRET=change_me_generate_a_32_byte_secret
ADMIN_API_KEY=change_me_admin_api_key
RATE_LIMIT_RPS=100

# Admin UI session (cookie + Redis). Use ADMIN_COOKIE_SECURE=true behind HTTPS.
# ADMIN_SESSION_TTL=24h
# ADMIN_COOKIE_SECURE=true

# Optional: portal GET /download (needs Redis). Values are NOT URLs.
# Docker Compose sets DOWNLOAD_* in the compose file.
# For local `go run` without Docker, uncomment:
# DOWNLOAD_FILE_PATH=/path/to/SaturX-release.zip
# DOWNLOAD_FILE_NAME=SaturX-Windows.zip

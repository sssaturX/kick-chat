PORT=8000
# Docker Compose: пароль БД (должен совпадать с контейнером postgres). Не задавайте DATABASE_URL/REDIS_URL
# в .env для docker — хост должен быть `postgres`/`redis`, не localhost (localhost внутри контейнера app — это не БД).
POSTGRES_PASSWORD=postgres

# Generate: openssl rand -base64 24 | tr -d '\n/' | head -c 32
HMAC_SECRET=DsfMy2oZ8LtLthk39WnRH0qSuIHDw9bo
ADMIN_API_KEY=LNgG9VeZ4m5cwkX4L0tBqHU5EQc66a8
RATE_LIMIT_RPS=100

# Admin UI session (cookie + Redis). Use ADMIN_COOKIE_SECURE=true behind HTTPS.
# ADMIN_SESSION_TTL=24h
# ADMIN_COOKIE_SECURE=true

# Optional: portal GET /download (needs Redis). Values are NOT URLs.
# Docker Compose задаёт DOWNLOAD_* в compose-файле; не добавляй в .env пустой DOWNLOAD_FILE_PATH=.
# Для локального go run без Docker раскомментируй:
# DOWNLOAD_FILE_PATH=/path/to/SaturX-release.zip
# DOWNLOAD_FILE_NAME=SaturX-Windows.zip

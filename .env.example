# В developers.kick.com Redirect URL = тот же, что и KICK_REDIRECT_URI (или http://localhost:8080/oauth/callback если DASHBOARD_PORT=8080 и переменная не задана).
KICK_REDIRECT_URI=http://localhost:8080/oauth/callback

KICK_CLIENT_ID=01KJ3MS8CM22FN5KB1VQY3YN72
KICK_CLIENT_SECRET=bb978625ce51debf18059d7f7f5338f1e46c89d8e09fd8f9ecdbe4823f02f012

# Optional: channel slug for chat (e.g. your Kick username)
CHANNEL_SLUG=

# DASHBOARD_PORT=8080

# ——— Сборка SaturX.exe (scripts/build-release.ps1) ———
# Читает корневой .env (рядом с go.mod) или файл из $env:ENV_FILE.
# LICENSE_HMAC_SECRET = тот же секрет, что HMAC_SECRET на license-server.
# LICENSE_SERVER_URL = без слэша в конце.
# LICENSE_SERVER_URL=https://license.example.com
# LICENSE_HMAC_SECRET=тот_же_что_HMAC_SECRET_на_сервере
#
# В готовом exe они зашиты; конечному пользователю в .env их не нужно.

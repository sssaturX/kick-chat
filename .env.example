# ——— Kick OAuth ———
# Redirect URL in developers.kick.com must match KICK_REDIRECT_URI
# (default: http://localhost:8080/oauth/callback when DASHBOARD_PORT=8080).
KICK_REDIRECT_URI=http://localhost:8080/oauth/callback

KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# Channel slug from the Kick URL: kick.com/<CHANNEL_SLUG>
CHANNEL_SLUG=your_channel

# DASHBOARD_PORT=8080

# Local development without license-server: SKIP_LICENSE=1 (never ship this to users)
# SKIP_LICENSE=1

# ——— SaturX.exe release build (scripts/build-release.ps1) ———
# Reads this file (or $env:ENV_FILE).
# LICENSE_HMAC_SECRET must match HMAC_SECRET on license-server.
# LICENSE_SERVER_URL has no trailing slash.
# LICENSE_SERVER_URL=https://license.example.com
# LICENSE_HMAC_SECRET=replace_with_the_same_hmac_as_the_server
#
# Those two values are embedded in the release binary. End users do not set them.

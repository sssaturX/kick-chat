# Telegram: create bot via @BotFather → token
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs for /admin and /ahelp (numeric id from @userinfobot etc.)
TELEGRAM_ADMIN_IDS=123456789

# Optional: show this image on /start (public HTTPS URL — if set, used first)
WELCOME_PHOTO_URL=
# Optional: local PNG/JPEG path (no hosting). Else bot looks for welcome_logo.png / logo.png next to cwd.
# WELCOME_PHOTO_PATH=./welcome_logo.png

# Download portal (license-server GET /download). If set, inline button after payment / My license / extend — not on /start.
SOFTWARE_DOWNLOAD_URL=https://example.com/download
SOFTWARE_DOWNLOAD_LINK_TEXT=Download SaturX

# Crypto Pay: @CryptoBot → Crypto Pay → Create App → API token
CRYPTOPAY_API_TOKEN=
# Use testnet for experiments (invoices in test crypto)
# CRYPTOPAY_TESTNET=true

# Same license API as SaturX (no trailing slash)
LICENSE_SERVER_URL=https://your-license-server.example
# Same as ADMIN_API_KEY on the license server
LICENSE_ADMIN_API_KEY=

# Amounts billed in USDT (Crypto Pay); copy: Standard ~$29/mo, Pro ~$129/yr
PRICE_STANDARD_USDT=29
PRICE_PRO_USDT=129

# License length after payment (Standard = monthly, Pro = yearly by default)
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_PERIOD_DAYS_PRO=365

# One-time demo access (72 hours = 3 days)
TRIAL_PERIOD_HOURS=72
TRIAL_MAX_ACTIVATIONS=1

# Referral bonus after a referred user pays successfully
REFERRAL_BONUS_DAYS=7

# How many devices can activate one key (license server max_activations)
LICENSE_MAX_ACTIVATIONS=2

# Poll invoice status until paid (no public webhook required).
# Keep TIMEOUT_MIN >= invoice lifetime: Crypto Pay invoice expires_in is 24h (86400s) in code.
INVOICE_POLL_SECONDS=12
INVOICE_POLL_TIMEOUT_MIN=1440

# Daily reminder scan (UTC hour 0–23)
REMINDER_HOUR_UTC=12

# SQLite file for bot state
BOT_SQLITE_PATH=telegram-sales-bot.db

# TELEGRAM_DEBUG=1
